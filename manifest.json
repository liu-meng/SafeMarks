{
  "manifest_version": 3,
  "name": "SafeMarks",
  "description": "零信任本地加密收藏夹扩展。",
  "version": "1.0.0",
  "permissions": [
    "storage",
    "alarms",
    "activeTab"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup/index.html",
    "default_title": "SafeMarks"
  },
  "options_page": "src/options/index.html"
}
