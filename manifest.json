{
  "manifest_version": 3,
  "name": "SafeMarks",
  "description": "零信任本地加密收藏夹扩展。",
  "version": "1.0.0",
  "permissions": [
    "storage",
    "alarms",
    "activeTab"
  ],
  "optional_permissions": [
    "bookmarks"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "icons": {
    "16": "assets/icons/safemarks-16.png",
    "32": "assets/icons/safemarks-32.png",
    "48": "assets/icons/safemarks-48.png",
    "128": "assets/icons/safemarks-128.png"
  },
  "action": {
    "default_popup": "src/popup/index.html",
    "default_title": "SafeMarks",
    "default_icon": {
      "16": "assets/icons/safemarks-16.png",
      "32": "assets/icons/safemarks-32.png",
      "48": "assets/icons/safemarks-48.png",
      "128": "assets/icons/safemarks-128.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      }
    },
    "quick-capture": {
      "suggested_key": {
        "default": "Ctrl+Shift+K",
        "mac": "Command+Shift+K"
      },
      "description": "打开快速收藏页（可选择已有目录或新增目录）"
    },
    "open-manager": {
      "suggested_key": {
        "default": "Ctrl+Shift+M",
        "mac": "Command+Shift+M"
      },
      "description": "打开 SafeMarks 收藏管理"
    },
    "open-settings": {
      "suggested_key": {
        "default": "Ctrl+Shift+Comma",
        "mac": "Command+Shift+Comma"
      },
      "description": "打开 SafeMarks 设置"
    }
  },
  "options_page": "src/options/index.html"
}
